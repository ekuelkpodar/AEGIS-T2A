# AEGIS-T2A Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_PATH=./data/aegis.db

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Provider options: anthropic, openai, openrouter, ollama
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_TEMPERATURE=0.7

# Anthropic Claude (https://console.anthropic.com/)
# Models: claude-opus-4-5-20251101, claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (https://platform.openai.com/)
# Models: gpt-4o, gpt-4-turbo, o3-mini
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter - Access 200+ models via single API (https://openrouter.ai/)
# Models: anthropic/claude-sonnet-4, openai/gpt-4o, google/gemini-2, meta-llama/llama-4
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# Ollama - Local models, no API key needed (https://ollama.ai/)
# Models: llama3.2, mistral, qwen2.5, deepseek-r1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# Cloud Provider Configuration
# =============================================================================

# AWS (https://aws.amazon.com/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=

# Azure (https://azure.microsoft.com/)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# GCP (https://cloud.google.com/)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# Communication Channels
# =============================================================================

# Telegram Bot (https://core.telegram.org/bots)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Slack Bot (https://api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# WhatsApp Business API (https://business.whatsapp.com/)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# =============================================================================
# Enterprise Security Features
# =============================================================================

# Memory Isolation Engine (HKDF-SHA256 cryptographic separation)
MEMORY_ISOLATION_ENABLED=false
MEMORY_ISOLATION_TTL_SECONDS=3600
MEMORY_DLP_ENABLED=true

# Runtime Policy Enforcement (FAIL-CLOSED mode)
RUNTIME_POLICY_ENFORCEMENT=false
POLICY_FAIL_CLOSED=true
PARAMETER_DRIFT_THRESHOLD=0.3

# Deterministic Replay Engine (SOC 2 CC7.2 compliance)
DETERMINISTIC_REPLAY_ENABLED=false
MERKLE_COMMIT_INTERVAL_MINUTES=5
REPLAY_RETENTION_DAYS=365

# Confidence-Aware Intent Parsing
CONFIDENCE_THRESHOLD=8
DISAMBIGUATION_ENABLED=true

# Blast Radius Analysis
MAX_BLAST_RADIUS_SCORE=70
REQUIRE_APPROVAL_ABOVE_SCORE=50

# =============================================================================
# Workflow Engine
# =============================================================================
WORKFLOW_CHECKPOINT_INTERVAL_MS=5000
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_BACKOFF_MS=1000
COMPENSATION_TIMEOUT_MS=300000

# =============================================================================
# Secrets Vault
# =============================================================================
SECRETS_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
SECRETS_TTL_SECONDS=300

# =============================================================================
# Simulation & Risk Analysis
# =============================================================================
SIMULATION_TIMEOUT_MS=30000
SIMULATION_MAX_ITERATIONS=100

# =============================================================================
# Approval Configuration
# =============================================================================
REQUIRE_APPROVAL=true
APPROVAL_THRESHOLD=medium
APPROVAL_MEDIUM_RISK_TTL_HOURS=24
APPROVAL_HIGH_RISK_TTL_HOURS=1

# =============================================================================
# Observability & Monitoring
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegis-t2a

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Audit Configuration
# =============================================================================
AUDIT_RETENTION_DAYS=365
AUDIT_HASH_ALGORITHM=sha256
AUDIT_SIGNATURE_ENABLED=true
