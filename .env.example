# AEGIS-T2A Environment Configuration

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_PATH=./data/aegis.db

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h

# LLM Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegis-t2a

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Workflow Engine
WORKFLOW_CHECKPOINT_INTERVAL_MS=5000
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_BACKOFF_MS=1000

# Secrets Vault
SECRETS_ENCRYPTION_KEY=your-32-byte-encryption-key-here
SECRETS_TTL_SECONDS=300

# Simulation
SIMULATION_TIMEOUT_MS=30000
SIMULATION_MAX_ITERATIONS=100

# Approval
APPROVAL_MEDIUM_RISK_TTL_HOURS=24
APPROVAL_HIGH_RISK_TTL_HOURS=1
