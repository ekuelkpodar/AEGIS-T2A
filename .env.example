# AEGIS-T2A Environment Configuration

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_PATH=./data/aegis.db

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h

# LLM Configuration
# Provider: anthropic, openai, openrouter, or ollama
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_TEMPERATURE=0.7

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your-openai-api-key

# OpenRouter - Access multiple models via single API (https://openrouter.ai/)
OPENROUTER_API_KEY=your-openrouter-api-key

# Ollama - Local models, no API key needed (https://ollama.ai/)
OLLAMA_BASE_URL=http://localhost:11434

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegis-t2a

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Workflow Engine
WORKFLOW_CHECKPOINT_INTERVAL_MS=5000
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_BACKOFF_MS=1000

# Secrets Vault
SECRETS_ENCRYPTION_KEY=your-32-byte-encryption-key-here
SECRETS_TTL_SECONDS=300

# Simulation
SIMULATION_TIMEOUT_MS=30000
SIMULATION_MAX_ITERATIONS=100

# Approval
APPROVAL_MEDIUM_RISK_TTL_HOURS=24
APPROVAL_HIGH_RISK_TTL_HOURS=1
