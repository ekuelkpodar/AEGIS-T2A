{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-t2a.dev/schemas/action.schema.json",
  "title": "AEGIS Canonical Action Definition",
  "description": "Industry-agnostic action contract used for validation, policy evaluation, simulation, and execution.",
  "type": "object",
  "required": [
    "action_id",
    "name",
    "version",
    "description",
    "parameters",
    "preconditions",
    "postconditions",
    "required_roles",
    "blast_radius",
    "compensation",
    "safety_score",
    "expected_cost",
    "execution"
  ],
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
      "description": "Stable unique identifier for the action."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version for action contract evolution."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "industry_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      },
      "default": []
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "default": []
    },
    "postconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "default": []
    },
    "required_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9:_-]{1,63}$"
      }
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9:*_-]{1,127}$"
      },
      "default": []
    },
    "blast_radius": {
      "$ref": "#/$defs/blastRadius"
    },
    "compensation": {
      "$ref": "#/$defs/compensation"
    },
    "safety_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Higher is safer. Used with policy thresholds."
    },
    "expected_cost": {
      "$ref": "#/$defs/expectedCost"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "compliance": {
      "$ref": "#/$defs/compliance",
      "default": {}
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": ["string", "number", "boolean", "array", "object", "null"]
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{1,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object",
            "datetime",
            "duration",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {},
        "validation": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["id", "description", "enforcement"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "enforcement": {
          "type": "string",
          "enum": ["system", "policy", "human"]
        }
      }
    },
    "blastRadius": {
      "type": "object",
      "required": ["level", "scope", "max_records", "max_systems", "reversible"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "scope": {
          "type": "string",
          "maxLength": 200
        },
        "max_records": {
          "type": "integer",
          "minimum": 0
        },
        "max_systems": {
          "type": "integer",
          "minimum": 1
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "compensation": {
      "type": "object",
      "required": ["strategy", "manual_playbook_required"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["none", "automatic", "manual", "hybrid"]
        },
        "undo_action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "manual_playbook_required": {
          "type": "boolean"
        },
        "playbook_ref": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "expectedCost": {
      "type": "object",
      "required": ["unit", "value", "max_allowed", "estimated_duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": ["usd", "credits", "seconds", "requests"]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "max_allowed": {
          "type": "number",
          "minimum": 0
        },
        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["adapter_type", "operation", "timeout_seconds", "retry_policy"],
      "additionalProperties": false,
      "properties": {
        "adapter_type": {
          "type": "string",
          "enum": ["http", "database", "crm", "erp", "telephony", "custom"]
        },
        "operation": {
          "type": "object",
          "additionalProperties": true
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "retry_policy": {
          "type": "object",
          "required": ["max_attempts", "backoff_seconds"],
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "backoff_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["gdpr", "hipaa", "soc2", "pci_dss", "iso_27001"]
          },
          "default": []
        },
        "contains_personal_data": {
          "type": "boolean",
          "default": false
        },
        "contains_phi": {
          "type": "boolean",
          "default": false
        },
        "lawful_basis_required": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
